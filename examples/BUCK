    cxx_binary(
        name = name,
        srcs = [src],
        headers = ["ExampleEndpoint.h"],
        deps = ["//rlib/endpoint:endpoint"],
        # Archives must precede the prebuilt libraries they use.
        link_ordering = "topological",
    )
    for name, src in [
