[
    cxx_binary(
        name = name,
        srcs = [src],
        headers = ["ExampleEndpoint.h"],
        deps = ["//rlib/endpoint:endpoint"],
        # Archives must precede the prebuilt libraries they use.
        link_ordering = "topological",
    )
    for name, src in [
        ("send_recv_server", "SendRecvServer.cpp"),
        ("send_recv_client", "SendRecvClient.cpp"),
        ("read_server", "ReadServer.cpp"),
        ("read_client", "ReadClient.cpp"),
    ]
]

cxx_library(
    name = "rpc_example",
    exported_headers = ["RpcExample.h"],
    exported_deps = ["//rlib/rpc:rpc"],
    visibility = ["PUBLIC"],
)

[
    cxx_binary(
        name = name,
        srcs = [src],
        deps = [":rpc_example"],
        # Archives must precede the prebuilt libraries they use.
        link_ordering = "topological",
    )
    for name, src in [
        ("rpc_server", "RpcServer.cpp"),
        ("rpc_client", "RpcClient.cpp"),
    ]
]
